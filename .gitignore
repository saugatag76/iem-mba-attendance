/node_modules
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts

# env / secrets
.env
.env*.local
.mcp.json

# raw source data dumps (timetables, imports) — kept local, never pushed
/data/

# DB backup dumps taken before destructive scripts (contain real student/teacher PII)
/backups/

# student rosters / timetables (contain names, phone, enrollment no.) — local only,
# anywhere in the repo, not just root
*.xlsx

# internal docs — kept local except the technical handoff and the two
# user-facing guides (student/teacher), which are meant to be public.
# (/docs/* not /docs/ — a directory-level match blocks descending into it
# at all, which breaks the negations below for files never tracked before)
/docs/*
!/docs/handoff.md
!/docs/teacher-guide.md
!/docs/student-guide.md
!/docs/production-readiness.md

# Claude Code skill packages — local tooling, not part of the app
/skills/

# prisma
/prisma/*.db
/prisma/*.db-journal

# os / editor
.DS_Store
*.log
