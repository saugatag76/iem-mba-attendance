# --- Database (PostgreSQL) ---
# Local Postgres example:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance?schema=public"
# Neon (free, no install — recommended for quick start): copy the pooled connection string.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance?schema=public"

# --- Auth.js ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Base URL of the app (used by Auth.js). In prod set to your https domain.
AUTH_URL="http://localhost:3000"
